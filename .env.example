# Copy to .env and fill in to run on a real Supabase project (README -> "Use a real Supabase backend").
# Leave empty to run fully offline on the seeded fake backend.
# The anon key is public by design; Row Level Security (supabase/migrations) is the security boundary.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Fake backend only: share of requests that fail (0..1). Unset = 1 in 20, as the brief asks.
# EXPO_PUBLIC_FAKE_API_CHAOS=0
