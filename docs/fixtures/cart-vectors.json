{
  "formula": "vat = floor((38*gross + 119) / 238)  // == round_half_up(gross*19/119), integer centimes; net = gross - vat",
  "unit": "centimes (1 DA = 100 centimes)",
  "cases": [
    {
      "name": "empty",
      "lines": [],
      "expected": {
        "gross": 0,
        "vat": 0,
        "net": 0
      }
    },
    {
      "name": "single item 1,800 x1",
      "lines": [
        {
          "priceH": 180000,
          "qty": 1
        }
      ],
      "expected": {
        "gross": 180000,
        "vat": 28739,
        "net": 151261
      }
    },
    {
      "name": "single item 1,800 x3",
      "lines": [
        {
          "priceH": 180000,
          "qty": 3
        }
      ],
      "expected": {
        "gross": 540000,
        "vat": 86218,
        "net": 453782
      }
    },
    {
      "name": "mixed",
      "lines": [
        {
          "priceH": 180000,
          "qty": 2
        },
        {
          "priceH": 435000,
          "qty": 1
        },
        {
          "priceH": 35000,
          "qty": 5
        }
      ],
      "expected": {
        "gross": 970000,
        "vat": 154874,
        "net": 815126
      }
    },
    {
      "name": "exactly 1,190.00 -> TVA 190.00",
      "lines": [
        {
          "priceH": 119000,
          "qty": 1
        }
      ],
      "expected": {
        "gross": 119000,
        "vat": 19000,
        "net": 100000
      }
    },
    {
      "name": "near-half-centime boundary (0.47 DA: 7.504 rounds up)",
      "lines": [
        {
          "priceH": 47,
          "qty": 1
        }
      ],
      "expected": {
        "gross": 47,
        "vat": 8,
        "net": 39
      }
    },
    {
      "name": "float trap 0.1+0.2 style",
      "lines": [
        {
          "priceH": 10,
          "qty": 1
        },
        {
          "priceH": 20,
          "qty": 1
        }
      ],
      "expected": {
        "gross": 30,
        "vat": 5,
        "net": 25
      }
    },
    {
      "name": "large qty",
      "lines": [
        {
          "priceH": 2480000,
          "qty": 99
        }
      ],
      "expected": {
        "gross": 245520000,
        "vat": 39200672,
        "net": 206319328
      }
    }
  ]
}
